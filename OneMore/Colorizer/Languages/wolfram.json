{
  "name": "Wolfram",
  "aliases": [],
  "rules": [
    {
      "pattern": "(\\(\\*(?:[^*]|\\*+[^*)])*\\*+\\))",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(\\(\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^([^\\r\\n]*\\*\\))",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(?s)(\"(?:\\\\.|[^\"\\\\])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\\$[A-Za-z][A-Za-z0-9]*)",
      "captures": [
        "Predefined"
      ]
    },
    {
      "pattern": "\\b([A-Z][A-Za-z0-9]+)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "([\\[\\]])",
      "captures": [
        "Delimeter"
      ]
    },
    {
      "pattern": "\\b([0-9]+(?:\\.[0-9]*)?(?:\\*\\^[+-]?[0-9]+)?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
