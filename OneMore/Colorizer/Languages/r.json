{
  "name": "R",
  "aliases": [
    "R"
  ],
  "rules": [
    {
      "pattern": "(\\#.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "('[^\\n]*?(?<!\\\\)')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)(\"[^\\n]*?(?<!\\\\)\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "\\b(break|else|for|function|if|in|next|repeat|return|while)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(FALSE|Inf|NA|NA_character_|NA_complex_|NA_integer_|NA_real_|NaN|NULL|TRUE)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b([A-Za-z_.][\\w.]*)(?=\\()",
      "captures": [
        "BuiltinFunction"
      ]
    },
    {
      "pattern": "\\b((?:0[xX][0-9a-fA-F]+|[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?)L?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
