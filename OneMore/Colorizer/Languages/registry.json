{
  "name": "Registry",
  "aliases": [
    "reg"
  ],
  "rules": [
    {
      "pattern": "^\\s*(;.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(Windows Registry Editor Version \\d\\.\\d+)",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "^(\\-\\s*\\[.*)$",
      "captures": [
        "RegDelete"
      ]
    },
    {
      "pattern": "[^\\-]?(\\[)([^[]+)(])$",
      "captures": [
        "PlainText",
        "PsuedoKeyword",
        "PlainText"
      ]
    },
    {
      "pattern": "(?<=dword:)([0-9a-fA-F]{1,8})\\b",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "(?<=hex(?:\\([0-9a-fA-F]+\\))?:)([0-9a-fA-F]{2}(?:,(?:\\\\\\r?\\n\\s*)?[0-9a-fA-F]{2})*)",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "\\b([0-9]{1,})\\b",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "=\\s*(hex(?:\\([0-9a-fA-F]+\\))?|hexadecimal|dword)",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "=\\s*(\"[^\\n]*?(?<!\\\\)\")",
      "captures": [
        "String"
      ]
    }
  ]
}
