{
  "name": "VisualBasic",
  "aliases": [
    "VB",
    "vb.net",
    "vbnet"
  ],
  "rules": [
    {
      "pattern": "('''[^\\n]*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "((?:'|REM\\s+).*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(\"(?:\"\"|[^\"\\n])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?:\\s|^)(\\#End\\sRegion|\\#Region|\\#Const|\\#End\\sExternalSource|\\#ExternalSource|\\#If|\\#Else|\\#End\\sIf)(?:\\s|\\(|\\r?$)",
      "captures": [
        "PreprocessorKeyword"
      ]
    },
    {
      "pattern": "^\\s*(<[A-Za-z_][^>\\r\\n]*>)",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "(?i)\\b(Case|Catch|Continue|Do|Each|Else|ElseIf|Exit|Finally|For|GoSub|GoTo|If|Loop|Next|Resume|Return|Select|Then|Throw|Try|While|Wend)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "(?i)\\b(Boolean|Byte|Char|Date|Decimal|Double|Integer|Long|Short|Single|String|Variant|SByte|UInteger|ULong|UShort)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "(?i)\\b(Class|Module|Structure|Interface|Enum)[ \\t]+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "(?i)\\b(AddHandler|AddressOf|Aggregate|Alias|All|And|AndAlso|Ansi|Any|As|Ascending|(?<!<)Assembly|Auto|Average|By|ByRef|ByVal|Call|CBool|CByte|CChar|CDate|CDec|CDbl|CInt|Class|CLng|CObj|Const|Count|CShort|CSng|CStr|CType|Declare|Default|DefaultStyleSheet|Delegate|Descending|Dim|DirectCast|Distinct|End|Enum|Equals|Erase|Error|Event|Explicit|False|Friend|From|Function|Get|GetType|Group|Group|Handles|Implements|Imports|In|Inherits|Interface|Into|Is|IsNot|Join|Let|Lib|Like|LongCount|Max|Me|Min|Mod|Module|MustInherit|MustOverride|My|MyBase|MyClass|Namespace|New|Not|Nothing|NotInheritable|NotOverridable|(?<!\\.)Object|Off|On|Option|Optional|Or|Order|OrElse|Overloads|Overridable|Overrides|ParamArray|Partial|Preserve|Private|Property|Protected|Public|RaiseEvent|ReadOnly|ReDim|RemoveHandler|Set|Shadows|Shared|Skip|Static|Step|Stop|Structure|Sub|Sum|SyncLock|Take|To|True|TypeOf|Unicode|Until|When|Where|With|WithEvents|WriteOnly|Xor|Using|CSByte|CUInt|CULng|CUShort|Async|Await)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "(?i)(&H[0-9A-F]+)\\b",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "(?i)\\b([0-9]+(?:\\.[0-9]+)?(?:E[+-]?[0-9]+)?[UILSDFR]{0,2})\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
