{
  "name": "bash",
  "aliases": [
    "sh"
  ],
  "rules": [
    {
      "pattern": "\\A(#![^\\r\\n]*)",
      "captures": [
        "Shebang"
      ]
    },
    {
      "pattern": "(#.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "('[^\\n]*?(?<!\\\\)')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)(\"[^\\n]*?(?<!\\\\)\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\\$\\{[^}\\r\\n]+\\})",
      "captures": [
        "ShellUserVariable"
      ]
    },
    {
      "pattern": "(?:(?:(\\$(?:\\$|\\#|\\@|\\*|\\?)(?<!\\b)))|(\\$(?:HOME|HOSTNAME|NAME|LINENO|PATH|PWD|SHELL|USER|UID|0)(?:\\b)))",
      "captures": [
        "ShellKnownVariable",
        "ShellKnownVariable"
      ]
    },
    {
      "pattern": "(\\$[\\p{L}_][\\p{L}\\p{N}_]*(?:\\b))",
      "captures": [
        "ShellUserVariable"
      ]
    },
    {
      "pattern": "\\b(break|case|continue|do|done|elif|else|esac|exit|fi|for|if|return|then|until|while)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(alias|cd|declare|echo|eval|exec|export|kill|local|printf|pwd|read|readonly|set|shift|source|test|trap|unset|wait)\\b",
      "captures": [
        "BuiltinFunction"
      ]
    },
    {
      "pattern": "\\b(coproc|function|in|select|time)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b([0-9]{1,})\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
