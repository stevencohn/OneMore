{
  "name": "Yaml",
  "aliases": [
    "yml"
  ],
  "rules": [
    {
      "pattern": "(?<![^\\s])(#.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(?s)(\"[^\\n]*?(?<!\\\\\\\\)\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\"[^\"\\n]*?\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "^[ \\t]*(?:-[ \\t]+)+(-?(?:0x[0-9a-fA-F]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?))(?=[ \\t]*(?:#.*)?$)",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "^[ \\t]*(?:-[ \\t]+)+((?:true|false|yes|no|on|off|null|~|True|False|Yes|No|Null|TRUE|FALSE|NULL))(?=[ \\t]*(?:#.*)?$)",
      "captures": [
        "BuiltinValue"
      ]
    },
    {
      "pattern": "^\\s*([^:]+)$",
      "captures": [
        "PlainText"
      ]
    },
    {
      "pattern": ":[ \\t]+(-?(?:0x[0-9a-fA-F]+|[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?))(?=[ \\t]*(?:#.*)?$)",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": ":[ \\t]+((?:true|false|yes|no|on|off|null|~|True|False|Yes|No|Null|TRUE|FALSE|NULL))(?=[ \\t]*(?:#.*)?$)",
      "captures": [
        "BuiltinValue"
      ]
    },
    {
      "pattern": "(?:[:>])\\s?((?:[^#\\n]|(?<=\\S)#)+)$",
      "captures": [
        "PlainText"
      ]
    },
    {
      "pattern": "^\\s*(-\\s*)?([^:\\n]+)",
      "captures": [
        "Operator",
        "Keyword"
      ]
    },
    {
      "pattern": "\\b([0-9]{1,})\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
