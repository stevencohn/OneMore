{
  "name": "Python",
  "rules": [
    {
      "pattern": "^((?:\\s*)\"{3}[^\\r\\n]*?\"{3}(?:\\s*))$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:\\s*)'{3}[^\\r\\n]*?'{3}(?:\\s*))$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:\\s*)\"{3}[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "([^\\r\\n\"]*\"{3}(?:\\s*))",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "\\A(#![^\\r\\n]*)",
      "captures": [
        "Shebang"
      ]
    },
    {
      "pattern": "(#[^\\r\\n]*)[]\\r\\n]?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "((?:[rRbBfFuU]{1,2})\"{3}[^\\r\\n]*?\"{3})",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "((?:[rRbBfFuU]{1,2})'{3}[^\\r\\n]*?'{3})",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "((?:[rRbBfFuU]{1,2})\"(?:\\\\.|[^\"\\\\\\r\\n])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "((?:[rRbBfFuU]{1,2})'(?:\\\\.|[^'\\\\\\r\\n])*')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "('(?:\\\\.|[^'\\\\\\r\\n])*')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "^\\s*(@[a-zA-Z_][a-zA-Z0-9_\\.]*)",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "\\b(break|case|continue|elif|else|except|finally|for|if|match|raise|return|try|while|yield)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(bool|bytearray|bytes|complex|dict|float|frozenset|int|list|object|range|set|str|tuple|type)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b(class)\\s+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "\\b(and|as|assert|async|await|class|def|del|exec|False|from|global|import|in|is|lambda|None|nonlocal|not|or|pass|print|True|with)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b(__[A-Za-z0-9_]+__)\\b",
      "captures": [
        "PsuedoKeyword"
      ]
    },
    {
      "pattern": "\\b((?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]*)?(?:[eE][+-]?[0-9]+)?)[jJ]?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
