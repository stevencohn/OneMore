{
  "name": "Batch",
  "aliases": [
    "bat",
    "cmd"
  ],
  "rules": [
    {
      // rem comment, @rem comment, :: comment
      "pattern": "(?i)^\\s*(@?rem\\b.*?|::.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      // batch has no backslash escape; "" is a literal quote
      "pattern": "(\"[^\\n]*?\")",
      "captures": [
        "String"
      ]
    },
    {
      // :label
      "pattern": "^\\s*(:[\\w.\\-]+)",
      "captures": [
        "PsuedoKeyword"
      ]
    },
    {
      // %%i, %%~i loop variables
      "pattern": "(%%~?[a-zA-Z])",
      "captures": [
        "ShellUserVariable"
      ]
    },
    {
      // %PATH% environment variables
      "pattern": "(%[A-Za-z_][^%\\s]*%)",
      "captures": [
        "ShellUserVariable"
      ]
    },
    {
      // %0-%9, %*, %~dp0 arguments and modifiers
      "pattern": "(%~?[a-zA-Z]*[0-9*])",
      "captures": [
        "ShellKnownVariable"
      ]
    },
    {
      // !var! delayed expansion
      "pattern": "(![A-Za-z_][^!\\s]*!)",
      "captures": [
        "ShellUserVariable"
      ]
    },
    {
      "pattern": "(?i)\\b(if|else|for|in|do|break|goto|call|choice|exit|setlocal|endlocal|shift|not|exist|defined|errorlevel|cmdextversion|enabledelayedexpansion|disabledelayedexpansion|enableextensions|disableextensions|equ|neq|lss|leq|gtr|geq)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      // commands only at the start of a statement: start of line, after & && | || (
      // (but not ^& ^|), or after do/else; allows leading whitespace and @
      "pattern": "(?i)(?<=(?:^|(?<!\\^)[&|\\(]|\\b(?:do|else)\\b)[ \\t]*@?[ \\t]*)\\b(echo|set|cd|chdir|copy|del|dir|md|mkdir|mklink|move|net|path|pause|rd|rmdir|ren|start|type|title|cls|pushd|popd|xcopy|robocopy|assoc|chcp|color|date|erase|ftype|prompt|rename|time|ver|verify|vol|attrib|cacls|icacls|takeown|comp|fc|find|findstr|more|sort|tree|where|timeout|forfiles|setx|reg|sc|schtasks|tasklist|taskkill|shutdown|runas|whoami|hostname|systeminfo|subst|ping|ipconfig|netsh|nslookup|tracert|curl|tar|certutil|wmic|msiexec|powershell|cmd|clip|doskey|mode|chkdsk|format|label|expand|replace)\\b",
      "captures": [
        "Keyword"
      ]  
    },
    {
      // @, redirection, pipes, and command separators
      "pattern": "(@|\\d?>>?(?:&\\d)?|<|\\|\\|?|&&?)",
      "captures": [
        "Operator"
      ]
    },
    {
      // /s /? switches
      "pattern": "(?<=\\s)(/[a-zA-Z?])\\b",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "\\b([0-9]+)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
