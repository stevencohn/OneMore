{
  "name": "Json",
  "aliases": [
    "json"
  ],
  "rules": [
    {
      "pattern": "^\\s*(/\\*(?:[^*]|[\\r\\n]|(?:\\*+(?:[^*/]|[\\r\\n])))*\\*+/)\\s*$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^\\s*(/\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:(?!/\\*)[^\\r\\n])*\\*/)\\s*$",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^\\s*(//.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")\\s*:\\s*(-?[0-9]{1,}(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)",
      "captures": [
        "JsonKey",
        "Number"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")\\s*:\\s*(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")",
      "captures": [
        "JsonKey",
        "String"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")\\s*:\\s*(\\[)",
      "captures": [
        "JsonKey",
        "Keyword"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")\\s*:\\s*(true|false|null)\\b",
      "captures": [
        "JsonKey",
        "Keyword"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")\\s*:",
      "captures": [
        "JsonKey"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\r\\n])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "\\b(true|false|null)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "(-?[0-9]{1,}(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "(\\[|\\])",
      "captures": [
        "Keyword"
      ]
    }
  ]
}
