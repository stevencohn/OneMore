{
  "name": "Rust",
  "aliases": [
    "rs"
  ],
  "rules": [
    {
      "pattern": "(/\\*(?:[^*]|[\\r\\n]|(?:\\*+(?:[^*/]|[\\r\\n])))*\\*+/)",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(/\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:(?!/\\*)[^\\r\\n])*\\*/)",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(///|//!)([^\\r\\n]*)",
      "captures": [
        "XmlDocTag",
        "XmlDocComment"
      ]
    },
    {
      "pattern": "(//.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(?s)((?:b)?r#\"(?:[^\"]|\"(?!#))*\"#)",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)((?:b)?r\"[^\"]*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)(b?\"(?:\\\\.|[^\"\\\\])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(b?'(?:\\\\(?:x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F_]+\\}|.)|[^\\\\'\\r\\n])')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "('[A-Za-z_]\\w*)(?!['\\w])",
      "captures": [
        "TypeVariable"
      ]
    },
    {
      "pattern": "(\\#!?\\[[^\\]\\r\\n]*\\])",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "\\b([A-Za-z_]\\w*!)(?=\\s*[\\(\\[\\{])",
      "captures": [
        "Macro"
      ]
    },
    {
      "pattern": "\\b(break|continue|else|for|if|loop|match|return|while)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(Arc|bool|Box|BTreeMap|char|f32|f64|HashMap|HashSet|i128|i16|i32|i64|i8|isize|Option|Rc|Result|str|String|u128|u16|u32|u64|u8|usize|Vec)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b(struct|enum|trait|union|type|mod)\\s+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "\\b(as|async|await|const|crate|dyn|enum|extern|false|fn|impl|in|let|mod|move|mut|pub|ref|Self|self|static|struct|super|trait|true|type|union|unsafe|use|where)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b([a-z_]\\w*)(::)(?=[A-Za-z_])",
      "captures": [
        "Namespace",
        "Delimeter"
      ]
    },
    {
      "pattern": "(?<=::)([A-Z]\\w*)\\b(?!\\s*\\()",
      "captures": [
        "ClassName"
      ]
    },
    {
      "pattern": "\\b((?:0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?)(?:_?(?:[iu](?:8|16|32|64|128|size)|f32|f64))?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
