{
  "name": "VHDL",
  "aliases": [
    "vhd"
  ],
  "rules": [
    {
      "pattern": "(--.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "([xXbBoO]\\\"[0-9a-fA-F_]*\\\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "('[^\\r\\n]')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\"[^\\r\\n\"]*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "\\b((?i:case|else|elsif|exit|for|if|loop|next|return|when|while))\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b((?i:bit|bit_vector|boolean|character|integer|natural|positive|real|signed|std_logic|std_logic_vector|std_ulogic|std_ulogic_vector|string|time|unsigned))\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b((?i:abs|access|after|alias|all|and|architecture|array|assert|attribute|begin|block|body|buffer|bus|component|configuration|constant|disconnect|downto|end|entity|file|function|generate|generic|group|guarded|impure|in|inertial|inout|is|label|library|linkage|literal|map|mod|nand|new|nor|not|null|of|on|open|or|others|out|package|port|postponed|procedure|process|protected|pure|range|record|register|reject|rem|report|rol|ror|select|severity|shared|signal|sla|sll|sra|srl|subtype|then|to|transport|type|unaffected|units|until|use|variable|wait|with|xnor|xor))\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b((?i:false|true))\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b([0-9]+#[0-9a-fA-F_.]+#)",
      "captures": [
        "Number"
      ]
    },
    {
      "pattern": "\\b([0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9]+)?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
