{
  "name": "Scala",
  "aliases": [
    "sc"
  ],
  "rules": [
    {
      "pattern": "(/\\*(?:[^*]|[\\r\\n]|(?:\\*+(?:[^*/]|[\\r\\n])))*\\*+/)",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(/\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:(?!/\\*)[^\\r\\n])*\\*/)",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(//.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(?s)((?:[a-z]+)?\"{3}.*?\"{3})",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "('[^\\n]*?(?<!\\\\)')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "((?:[a-z]+)?\"[^\\n]*?(?<!\\\\)\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(@[a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "\\b(case|catch|do|else|finally|for|if|match|return|then|throw|try|while|yield)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(Any|AnyRef|AnyVal|Array|BigDecimal|BigInt|Boolean|Byte|Char|Double|Either|Failure|Float|Future|Int|Left|List|Long|Map|Nil|None|Nothing|Null|Option|Right|Seq|Set|Short|Some|String|Success|Try|Tuple|Unit|Vector)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b(class|trait|object|enum|type)\\s+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "\\b(abstract|class|def|derives|enum|export|extends|extension|false|final|forSome|given|implicit|import|inline|lazy|macro|new|null|object|opaque|open|override|package|private|protected|sealed|super|this|trait|transparent|true|type|using|val|var|with)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b(0[xX][0-9a-fA-F]+[lL]?|[0-9]+(?:\\.[0-9]+)?(?:[eE][+\\-]?[0-9]+)?[fFdDlL]?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
