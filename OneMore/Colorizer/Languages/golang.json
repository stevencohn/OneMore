{
  "name": "Go",
  "aliases": [
    "golang"
  ],
  "rules": [
    {
      "pattern": "(/\\*(?:[^*]|[\\r\\n]|(?:\\*+(?:[^*/]|[\\r\\n])))*\\*+/)",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(/\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:(?!/\\*)[^\\r\\n])*\\*/)",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(//.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "('(?:\\\\.[^\\n']*|[^\\n'\\\\])')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\n])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)(`[^`]*`)",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "\\b(break|case|continue|default|defer|else|fallthrough|for|go|goto|if|range|return|select|switch)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(any|bool|byte|comparable|complex128|complex64|error|float32|float64|int|int16|int32|int64|int8|rune|string|uint|uint16|uint32|uint64|uint8|uintptr)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b(type)\\s+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "\\b(chan|const|func|import|interface|map|package|struct|type|var)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b(false|iota|nil|true)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b(append|cap|clear|close|complex|copy|delete|imag|len|make|max|min|new|panic|print|println|real|recover)\\b(?=\\()",
      "captures": [
        "BuiltinFunction"
      ]
    },
    {
      "pattern": "\\b((?:0[xX][0-9a-fA-F_.]+(?:[pP][+-]?[0-9]+)?|0[bBoO][0-7_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?)(?:i)?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
