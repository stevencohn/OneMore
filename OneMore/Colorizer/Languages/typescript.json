{
  "name": "Typescript",
  "aliases": [
    "ts"
  ],
  "rules": [
    {
      "pattern": "(/\\*(?:[^*]|[\\r\\n]|(?:\\*+(?:[^*/]|[\\r\\n])))*\\*+/)",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(/\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:(?!/\\*)[^\\r\\n])*\\*/)",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(//.*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "('(?:\\\\.|[^'\\\\\\n])*')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\"(?:\\\\.|[^\"\\\\\\n])*\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)(`(?:\\\\.|[^`\\\\])*`)",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?<=[=\\(:,!&|?{};]\\s*)(/(?![/*])(?:\\\\.|\\[(?:\\\\.|[^\\]\\r\\n\\\\])*\\]|[^/\\\\\\r\\n\\[])+/[dgimsuvy]*)",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(@[A-Za-z_$][\\w$.]*)",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "\\b(break|case|catch|continue|default|do|else|finally|for|goto|if|return|switch|throw|try|while|yield)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(any|Array|BigInt|bigint|Boolean|boolean|Date|Error|JSON|Map|Math|never|Number|number|Object|object|Promise|RegExp|Set|String|string|Symbol|symbol|undefined|unknown|WeakMap|WeakSet)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b(class|interface|enum|type|namespace)\\s+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "\\b(abstract|accessor|as|asserts|async|await|class|const|constructor|debugger|declare|delete|enum|export|extends|false|function|implements|import|in|infer|Infinity|instanceof|interface|is|keyof|let|module|namespace|NaN|new|null|of|out|override|private|protected|public|readonly|satisfies|static|super|this|true|type|typeof|var|void|with)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b((?:0[xX][0-9a-fA-F_]+|0[bBoO][01_0-7]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?)(?:n)?)\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
