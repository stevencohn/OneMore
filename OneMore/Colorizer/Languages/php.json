{
  "name": "PHP",
  "aliases": [
    "php"
  ],
  "rules": [
    {
      "pattern": "(/\\*(?:[^*]|[\\r\\n]|(?:\\*+(?:[^*/]|[\\r\\n])))*\\*+/)",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(/\\*[^\\r\\n]*)$",
      "scope": "Comment",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "^((?:(?!/\\*)[^\\r\\n])*\\*/)",
      "scope": "",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "(<\\?php|<\\?=|\\?>)",
      "captures": [
        "PreprocessorKeyword"
      ]
    },
    {
      "pattern": "(\\#\\[[^\\]\\r\\n]*\\])",
      "captures": [
        "Attribute"
      ]
    },
    {
      "pattern": "((?://|#).*?)\\r?$",
      "captures": [
        "Comment"
      ]
    },
    {
      "pattern": "('[^\\n]*?(?<!\\\\)')",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(?s)(\"[^\\n]*?(?<!\\\\)\")",
      "captures": [
        "String"
      ]
    },
    {
      "pattern": "(\\$[a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": [
        "Variable"
      ]
    },
    {
      "pattern": "\\b(break|case|catch|continue|default|die|do|else|elseif|endfor|endforeach|endif|endswitch|endwhile|exit|finally|for|foreach|goto|if|match|return|switch|throw|try|while|yield)\\b",
      "captures": [
        "ControlKeyword"
      ]
    },
    {
      "pattern": "\\b(array|bool|callable|double|float|int|integer|iterable|mixed|never|numeric|object|parent|real|self|string|void)\\b",
      "captures": [
        "Type"
      ]
    },
    {
      "pattern": "\\b(FALSE|false|NULL|null|TRUE|true)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b(class|interface|trait|enum)\\s+([A-Za-z_]\\w*)",
      "captures": [
        "Keyword",
        "ClassName"
      ]
    },
    {
      "pattern": "\\b(__halt_compiler|abstract|and|as|class|clone|const|declare|echo|empty|enddeclare|enum|eval|extends|final|fn|function|global|implements|include|include_once|instanceof|insteadof|interface|isset|list|namespace|new|or|print|private|protected|public|readonly|require|require_once|static|trait|unset|use|var|xor)\\b",
      "captures": [
        "Keyword"
      ]
    },
    {
      "pattern": "\\b(__(?>CLASS|DIR|FILE|FUNCTION|LINE|METHOD|NAMESPACE|TRAIT)__)\\b",
      "captures": [
        "Predefined"
      ]
    },
    {
      "pattern": "\\b((?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO]?[0-7_]+|[0-9][0-9_]*(?:\\.[0-9_]*)?(?:[eE][+-]?[0-9]+)?))\\b",
      "captures": [
        "Number"
      ]
    }
  ]
}
